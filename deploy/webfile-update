#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "Usage: sudo webfile-update <release.tar.gz URL> <release.tar.gz.sha256 URL>" >&2
  exit 2
}

[[ $# -eq 2 ]] || usage
[[ $EUID -eq 0 ]] || { echo "Run as root (sudo)." >&2; exit 1; }

TARBALL_URL="$1"
SHA_URL="$2"
WORK="$(mktemp -d)"
ROLLBACK_NEEDED=false
BINARY_STAGE=""
UPDATER_STAGE=""

cleanup() {
  local status=$?
  trap - EXIT
  set +e
  if [[ "$status" -ne 0 && "$ROLLBACK_NEEDED" == true ]]; then
    if ! rollback; then
      echo "Rollback was incomplete; inspect the WebFile installation and service status." >&2
    fi
  fi
  [[ -z "$BINARY_STAGE" ]] || rm -f -- "$BINARY_STAGE"
  [[ -z "$UPDATER_STAGE" ]] || rm -f -- "$UPDATER_STAGE"
  rm -rf -- "$WORK"
  exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

curl --fail --location --proto '=https' --tlsv1.2 "$TARBALL_URL" -o "$WORK/release.tar.gz"
curl --fail --location --proto '=https' --tlsv1.2 "$SHA_URL" -o "$WORK/release.tar.gz.sha256"
(
  cd "$WORK"
  expected="$(awk 'NR==1 {print $1}' release.tar.gz.sha256)"
  [[ "$expected" =~ ^[0-9a-fA-F]{64}$ ]] || { echo "Invalid checksum file" >&2; exit 1; }
  printf '%s  %s\n' "$expected" release.tar.gz | sha256sum --check -
)
mkdir "$WORK/release"
tar -xzf "$WORK/release.tar.gz" -C "$WORK/release" --strip-components=1
[[ -x "$WORK/release/webfile" ]] || { echo "Release does not contain webfile binary" >&2; exit 1; }

NEW_VERSION="$($WORK/release/webfile version || true)"
echo "Installing $NEW_VERSION"
mkdir "$WORK/previous"

backup_file() {
  local source="$1"
  local name="$2"
  if [[ -e "$source" ]]; then
    cp -a "$source" "$WORK/previous/$name"
  else
    touch "$WORK/previous/$name.absent"
  fi
}

restore_file() {
  local destination="$1"
  local name="$2"
  if [[ -e "$WORK/previous/$name.absent" ]]; then
    rm -f -- "$destination"
  else
    local temporary
    temporary="$(mktemp "${destination}.rollback.XXXXXX")" || return 1
    if cp -a "$WORK/previous/$name" "$temporary" && mv -f -- "$temporary" "$destination"; then
      return 0
    fi
    rm -f -- "$temporary"
    return 1
  fi
}

rollback() {
  echo "Restoring previous WebFile installation." >&2
  local failed=0
  restore_file /usr/local/bin/webfile webfile || failed=1
  restore_file /usr/local/sbin/webfile-update webfile-update || failed=1
  restore_file /etc/systemd/system/webfile.service webfile.service || failed=1
  restore_file /etc/systemd/system/webfile-launcher.service webfile-launcher.service || failed=1
  restore_file /usr/lib/tmpfiles.d/webfile.conf webfile.tmpfiles || failed=1
  restore_file /etc/pam.d/webfile webfile.pam || failed=1
  systemctl daemon-reload || failed=1
  systemctl restart webfile-launcher.service webfile.service || failed=1
  return "$failed"
}

backup_file /usr/local/bin/webfile webfile
backup_file /usr/local/sbin/webfile-update webfile-update
backup_file /etc/systemd/system/webfile.service webfile.service
backup_file /etc/systemd/system/webfile-launcher.service webfile-launcher.service
backup_file /usr/lib/tmpfiles.d/webfile.conf webfile.tmpfiles
backup_file /etc/pam.d/webfile webfile.pam

# All backups must exist before any installation file is replaced.
ROLLBACK_NEEDED=true
BINARY_STAGE="$(mktemp /usr/local/bin/.webfile-bin.XXXXXX)"
install -m0755 "$WORK/release/webfile" "$BINARY_STAGE"
mv -f -- "$BINARY_STAGE" /usr/local/bin/webfile
UPDATER_STAGE="$(mktemp /usr/local/sbin/.webfile-update.XXXXXX)"
install -m0755 "$WORK/release/deploy/webfile-update" "$UPDATER_STAGE"
mv -f -- "$UPDATER_STAGE" /usr/local/sbin/webfile-update

# Unit/PAM changes ship with releases, but the local config is never replaced.
install -m0644 "$WORK/release/deploy/webfile.service" /etc/systemd/system/webfile.service
install -m0644 "$WORK/release/deploy/webfile-launcher.service" /etc/systemd/system/webfile-launcher.service
install -m0644 "$WORK/release/deploy/webfile.tmpfiles" /usr/lib/tmpfiles.d/webfile.conf
install -m0644 "$WORK/release/deploy/webfile.pam" /etc/pam.d/webfile
systemctl daemon-reload

if ! systemctl restart webfile-launcher.service webfile.service; then
  echo "Update failed to start." >&2
  exit 1
fi

sleep 1
if ! systemctl is-active --quiet webfile.service; then
  echo "WebFile did not stay active." >&2
  exit 1
fi

ROLLBACK_NEEDED=false
echo "Update complete: $(/usr/local/bin/webfile version)"
