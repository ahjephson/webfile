{
  "listen": "127.0.0.1:8080",
  "editor_max_bytes": 5242880,
  "auth": {
    "mode": "none",
    "pam_service": "webfile",
    "session_ttl": "12h",
    "elevation_ttl": "5m",
    "cookie_secure": false,
    "login_max_attempts": 5,
    "login_window": "1m",
    "login_block": "5m"
  },
  "runtime": {
    "worker_dir": "/tmp/webfile-users",
    "data_dir": "/tmp/webfile-data",
    "launcher_socket": "/tmp/webfile-launcher.sock",
    "launcher_group": "webfile",
    "min_user_uid": 1000
  },
  "thumbnails": {
    "cache_dir": "/tmp/webfile-thumbnail-cache",
    "cache_socket": "/tmp/webfile-thumbnail-cache.sock",
    "cache_max_bytes": 10737418240,
    "image_workers": 2,
    "video_workers": 2,
    "video_ffmpeg_threads": 2,
    "video_timeout_seconds": 300,
    "max_queued": 200
  },
  "roots": [
    { "name": "Home", "path": "{home}", "excluded_names": ["lost+found"] }
  ],
  "archive": {
    "executable": "/usr/bin/7z",
    "create_args": ["a", "-tzip", "-y", "-bsp1", "-bso0", "-bse2", "-snl", "{archive}"],
    "extract_args": ["x", "-y", "-bsp1", "-bso0", "-bse2", "{archive}", "-o{destination}"],
    "inspect_args": ["l", "-slt", "{archive}"],
    "inspect_password_arg": "-p"
  }
}
